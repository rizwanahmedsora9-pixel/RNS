# --- Gradle / Android build output ---
.gradle/
build/
app/build/
captures/
.externalNativeBuild/
.cxx/
local.properties

# --- IDE ---
.idea/
*.iml
.DS_Store

# --- Shell scripts are generated into assets at build time by :syncShellScripts.
# scripts/ is the single source of truth; do not commit the copies. ---
app/src/main/assets/*.sh

# --- Local signing material (never commit keystores) ---
*.jks
*.keystore
keystore.properties

# Exception: the shared *release-grade* signing key below IS committed on purpose.
# Every build (local or CI, debug or release) is signed with it so a new APK
# always installs as an in-place update over an older one. See app/build.gradle.
!keystore/hotspot-billing.p12

# --- CI scratch space ---
.audit/

# --- Emulator E2E scratch (tools/emulator-smoke.sh output, CI logs) ---
emulator-smoke/
e2e-diagnostics/
gradle-e2e.log
logcat-emulator.txt
dumpsys-processes.txt

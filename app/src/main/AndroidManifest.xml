<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34+ requires the type-specific permission on top of FOREGROUND_SERVICE. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Android refuses to let an app create ANY WiFi network - hotspot,
      local-only hotspot or a WiFi Direct group - without location permission
      (API 26-32) or NEARBY_WIFI_DEVICES (API 33+). NetShare-style sharing is
      impossible without them, so they are requested at runtime on first start.
      Location services must also be switched ON in the system settings; the
      debugger says so explicitly when that is the reason an AP failed.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!-- WiFi Direct is how the NetShare-style AP is created; not every phone has it. -->
    <uses-feature
        android:name="android.hardware.wifi.direct"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />
    <!-- Root access is granted via Magisk, not a manifest permission -->

    <application
        android:name=".RnsApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
          The launcher is the splash, not the dashboard: the app must always
          open onto a screen, even when something went wrong before - the
          splash shows the previous run's crash and never dies on its own.
          From there: root check (every launch) -> wizard (first run) or
          dashboard (already set up).
        -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- The onboarding wizard, one screen per step. -->
        <activity
            android:name=".RootCheckActivity"
            android:exported="false"
            android:label="Root check" />
        <activity
            android:name=".SetupHotspotActivity"
            android:exported="false"
            android:label="Setup - hotspot" />
        <activity
            android:name=".SetupVoucherActivity"
            android:exported="false"
            android:label="Setup - vouchers" />
        <activity
            android:name=".SetupStartActivity"
            android:exported="false"
            android:label="Setup - start" />

        <!-- The debugger: live log tail, watchdog findings, and the one-tap full
             diagnostic report that gets copied or shared. Reachable from the
             dashboard, from Settings and from the ongoing notification. -->
        <activity
            android:name=".DebugActivity"
            android:exported="false"
            android:label="Debugger"
            android:parentActivityName=".MainActivity" />

        <!-- Owns the whole gateway: root lifecycle, hotspot/AP bring-up (including
             the no-toggle NetShare paths), NAT/DHCP/firewall, captive portal,
             voucher sweep, watchdog, re-apply on interface changes. Runs as a
             foreground service so the portal survives the activity being swiped away. -->
        <service
            android:name=".HotspotService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Shares the saved .txt debug reports with other apps (WhatsApp, Drive). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.hotspot.billing.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>

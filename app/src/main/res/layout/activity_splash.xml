<?xml version="1.0" encoding="utf-8"?>
<!--
  Screen 0 - the splash. Branding, version/device line, the crash saved from
  the previous run (if any) and a debugger shortcut. Every id below is bound
  in SplashActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RNS"
            android:textSize="44sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:letterSpacing="0.06" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Hotspot Billing Gateway"
            android:textSize="15sp"
            android:textColor="@color/textDim" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="rooted Android · voucher hotspot"
            android:textSize="11sp"
            android:textColor="@color/textDim" />

        <TextView
            android:id="@+id/splash_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textSize="11sp"
            android:textColor="@color/textDim"
            android:fontFamily="monospace" />

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp" />

        <TextView
            android:id="@+id/splash_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Starting..."
            android:textSize="12sp"
            android:textColor="@color/textDim" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- A crash from the PREVIOUS run: the "it died before it opened" case,
         made readable the next time the app opens. -->
    <TextView
        android:id="@+id/splash_crash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone"
        android:background="@color/redSoft"
        android:padding="14dp"
        android:textColor="@color/textPrimary"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="3dp"
        android:clickable="true"
        android:focusable="true"
        android:textIsSelectable="true"
        android:maxLines="12"
        android:ellipsize="end" />

    <Button
        android:id="@+id/splash_debugger"
        style="@style/BtnOutline"
        android:layout_width="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="Open debugger / error log" />
</LinearLayout>

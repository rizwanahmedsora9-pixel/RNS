<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/card"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/c_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:text="Ali - Samsung A12" />

        <TextView
            android:id="@+id/c_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="@color/textDim"
            android:text="aa:bb:cc:dd:ee:ff / 10.66.0.12" />

        <TextView
            android:id="@+id/c_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="@color/green"
            android:text="1 Hour - 2Mbps, 42m left" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button android:id="@+id/c_profile" style="@style/RowButton" android:text="Profile" />
        <Button android:id="@+id/c_kick" style="@style/RowButton" android:text="Kick" android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
